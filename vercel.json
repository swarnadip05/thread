{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm --filter @thread/web... build",
  "installCommand": "pnpm install",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
