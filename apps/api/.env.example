# Local development defaults. Generate both secrets before starting the API.
# Never put API secrets in apps/web or NEXT_PUBLIC_* variables.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
TRUST_PROXY_HOPS=
MONGODB_URI=mongodb://localhost:27017/thread_commerce?replicaSet=rs0
REDIS_URL=redis://localhost:6379
SOCKET_REDIS_ADAPTER_ENABLED=false
EMAIL_PROVIDER=local
SMTP_HOST=127.0.0.1
SMTP_PORT=4000
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PAYMENT_PROVIDER=mock
RAZORPAY_MODE=
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_ISSUER=
ACCESS_TOKEN_AUDIENCE=
COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
PHONE_AUTH_ENABLED=false
TOTP_ENABLED=false
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_CONFIRM=
DEMO_SEED_CONFIRM=
PRODUCT_PREVIEW_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=thread/products
MAX_CART_QUANTITY=
DELIVERY_POSTAL_PREFIXES=
PII_RETENTION_DAYS=
ALERT_WEBHOOK_URL=
