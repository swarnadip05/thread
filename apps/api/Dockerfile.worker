# syntax=docker/dockerfile:1.7

FROM node:24.18.0-bookworm-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable && corepack prepare pnpm@11.15.0 --activate

WORKDIR /workspace
COPY . .

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile
RUN pnpm --filter @thread/api... build
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm --filter @thread/api deploy --prod --legacy /opt/thread-worker

FROM node:24.18.0-bookworm-slim AS runtime

ENV NODE_ENV=production

RUN apt-get update \
    && apt-get install --no-install-recommends --yes ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --chown=node:node --from=build /opt/thread-worker/package.json ./package.json
COPY --chown=node:node --from=build /opt/thread-worker/node_modules ./node_modules
COPY --chown=node:node --from=build /opt/thread-worker/dist ./dist

USER node

ENTRYPOINT ["tini", "--"]
CMD ["node", "dist/worker.js"]
