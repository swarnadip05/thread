{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_ANALYTICS_MEASUREMENT_ID",
        "NEXT_PUBLIC_ANALYTICS_PROVIDER",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_APP_ENV",
        "NEXT_PUBLIC_GOOGLE_AUTH_ENABLED",
        "NEXT_PUBLIC_PHONE_AUTH_ENABLED",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_SOCKET_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "env": [
        "HOST",
        "LOG_LEVEL",
        "MONGODB_URI",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_SOCKET_URL",
        "PORT",
        "REDIS_URL",
        "WEB_ORIGIN"
      ],
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
